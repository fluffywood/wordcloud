# WordFlow server configuration
PORT=5173
HOST=0.0.0.0

# Use "b" for the second CityU question; omit or use "a" for the original poll.
# POLL_VARIANT=b

# Strongly recommended when the app is reachable from the public internet.
# Open /?admin=the-same-value once in the host browser after setting it.
# ADMIN_KEY=replace-with-a-long-random-string

# Override the QR/link origin when deployed behind a proxy or when a VPN causes
# the wrong LAN address to be selected. Include the protocol, without /join.
# PUBLIC_URL=https://wordflow.example.com

# Put this on a persistent volume in production.
# WORDCLOUD_DATA_FILE=/app/data/wordcloud.json

# Capacity safeguards for one server process.
# MAX_RESPONSES=2000
# MAX_SSE_CLIENTS=500
