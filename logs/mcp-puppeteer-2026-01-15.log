{"arguments":{"script":"\n// The issue is the escaping logic. Let's trace through it:\nconst word = \"a**\";\n\n// Step 1: Escape special chars (but * is being escaped too!)\nconst escaped = word.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconsole.log('After escape:', escaped);  // This gives \"a\\*\\*\"\n\n// Step 2: Replace escaped asterisks with dots\nconst pattern = escaped.replace(/\\\\\\*/g, '.');\nconsole.log('After pattern:', pattern);  // This gives \"a..\"\n\n// So the pattern is \"a..\" which matches any letter followed by 2 chars\n// But with \\b boundaries, let's see what happens\n\nconst regex = new RegExp(`\\\\b${pattern}\\\\b`, 'i');\nconsole.log('Regex:', regex);\n\n// Test\nconst text = \"AI coding assistant with voice control\";\nconst normalized = text.toLowerCase();\n\n// Find all matches\nlet match;\nconst allMatches = [];\nconst regexGlobal = new RegExp(`\\\\b${pattern}\\\\b`, 'gi');\nwhile ((match = regexGlobal.exec(normalized)) !== null) {\n  allMatches.push({ match: match[0], index: match.index });\n}\nconsole.log('All matches:', allMatches);\n\nreturn { escaped, pattern, allMatches };\n"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2026-01-15 16:39:32.249","tool":"puppeteer_evaluate"}
