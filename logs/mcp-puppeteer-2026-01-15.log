{"arguments":{"script":"\nconst profanityList = [\n  'fuck', 'f*ck', 'f**k', 'fck', 'fuk', 'fvck', 'fucc', 'phuck', 'phuk',\n  'shit', 'sh*t', 'sh1t', 'sht', 'shlt', 'schit',\n  'ass', 'a$$', 'a**', '@ss',\n  'bitch', 'b*tch', 'b1tch', 'biatch',\n  'damn', 'd*mn', 'dmn',\n  'hell',\n  'crap',\n  'dick', 'd*ck', 'd1ck',\n  'cock', 'c*ck', 'c0ck',\n  'pussy', 'p*ssy', 'pu$$y',\n  'cunt', 'c*nt', 'cvnt',\n  'whore', 'wh*re', 'h0e', 'hoe',\n  'slut', 'sl*t',\n  'bastard', 'b*stard',\n  'piss', 'p*ss',\n  'nigger', 'n*gger', 'n1gger', 'nigg', 'n*gg',\n  'nigga', 'n*gga',\n  'faggot', 'f*ggot', 'fag', 'f*g',\n  'retard', 'r*tard', 'retrd',\n  'kike', 'k*ke',\n  'spic', 'sp*c',\n  'chink', 'ch*nk',\n  'wetback',\n  'beaner',\n  'porn', 'p*rn', 'pron',\n  'xxx',\n  'sex',\n  'nude', 'nudes',\n  'naked',\n  'horny', 'h*rny',\n  'dildo',\n  'vibrator',\n  'masturbat',\n  'jerkoff', 'jerk off',\n  'blowjob', 'blow job',\n  'handjob', 'hand job',\n  'cumshot', 'cum shot', 'cum',\n  'orgasm',\n  'erection',\n  'penis', 'pen*s',\n  'vagina', 'vag*na',\n  'boobs', 'boob', 'b00bs', 'tits', 't*ts', 'titties',\n  'kill',\n  'murder',\n  'rape', 'r*pe',\n  'suicide',\n  'cocaine', 'coke',\n  'heroin',\n  'meth',\n  'weed',\n  'marijuana',\n];\n\nconst testText = \"AI coding assistant with voice control\";\nconst normalized = testText.toLowerCase();\n\nconst matches = [];\nfor (const word of profanityList) {\n  const escaped = word.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  const pattern = escaped.replace(/\\\\\\*/g, '.');\n  const regex = new RegExp(`\\\\b${pattern}\\\\b`, 'i');\n  if (regex.test(normalized)) {\n    matches.push({ word, pattern });\n  }\n}\n\nconsole.log('Matches found:', matches);\nreturn matches;\n"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2026-01-15 16:39:13.818","tool":"puppeteer_evaluate"}
