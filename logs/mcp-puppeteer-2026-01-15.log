{"arguments":{"script":"\n// The escaped pattern for \"a**\" becomes \"a\\.\\.\" \n// But the second step converts \"\\*\" to \".\" so we get \"a..\"\n// With word boundaries: \\ba..\\b\n\nconst pattern = \"a..\";  // from \"a**\"\nconst regex = new RegExp(`\\\\b${pattern}\\\\b`, 'i');\nconst text = \"AI coding assistant with voice control\";\n\n// Test against the text\nconst normalized = text.toLowerCase();\nconsole.log('Testing pattern:', `\\\\b${pattern}\\\\b`);\nconsole.log('Against:', normalized);\nconsole.log('Result:', regex.test(normalized));\n\n// Let's also check what's matching\nconst match = normalized.match(regex);\nconsole.log('Match:', match);\n\nreturn { pattern: `\\\\b${pattern}\\\\b`, matches: regex.test(normalized), match };\n"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2026-01-15 16:39:22.231","tool":"puppeteer_evaluate"}
