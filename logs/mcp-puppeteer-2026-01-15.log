{"arguments":{"script":"\n// Let's test what the filter catches\nconst testPhrases = [\n  \"AI coding assistant with voice control\",\n  \"assistant\",\n  \"ass\",\n  \"hello world\"\n];\n\nconst results = testPhrases.map(phrase => {\n  // Test using the actual imported function from the module\n  const normalized = phrase.toLowerCase();\n  \n  // Replicate the pattern\n  const pattern = /\\bass\\b/i;\n  const matches = pattern.test(normalized);\n  \n  return { phrase, matches };\n});\n\nconsole.log('Results:', JSON.stringify(results, null, 2));\nreturn results;\n"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2026-01-15 16:38:57.779","tool":"puppeteer_evaluate"}
