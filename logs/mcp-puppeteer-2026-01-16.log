{"arguments":{"script":"\n// Look for all elements containing blockchain text\nconst all = document.body.querySelectorAll('*');\nconst results = [];\nfor (const el of all) {\n  if (el.childNodes.length === 1 && el.textContent.toLowerCase() === 'blockchain') {\n    results.push({tag: el.tagName, class: el.className, parent: el.parentElement?.tagName});\n  }\n}\nJSON.stringify(results);\n"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2026-01-16 02:11:47.534","tool":"puppeteer_evaluate"}
